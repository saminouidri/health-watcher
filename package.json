{
  "name": "health-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight homelab health checker (runs on a Raspberry Pi; no build step).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "HOST=127.0.0.1 node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
